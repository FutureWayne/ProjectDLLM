# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.DotSettings.user
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

.idea/
Content/Assets/
# Character source assets stay local except the production CyberNinja materials.
/Content/Characters/*
!/Content/Characters/CyberNinja/
/Content/Characters/CyberNinja/*
!/Content/Characters/CyberNinja/Materials/
/Content/Characters/CyberNinja/Materials/*
!/Content/Characters/CyberNinja/Materials/M_Body.uasset
!/Content/Characters/CyberNinja/Materials/M_Head.uasset
!/Content/Characters/CyberNinja/Materials/M_Legs.uasset
Content/Audio/
/Windows/
*.zip

# Local Codex configuration
/.codex/

# Python bytecode generated by editor and asset maintenance scripts
__pycache__/
*.pyc
*.pyo

# Generated logs.
# Automation reports and screenshots default to the already ignored Saved/ tree.
*.log

# Local asset setup and validation scripts; keep C++ test sources tracked.
/Scripts/
/Plugins/**/Tests/*.ps1

# Local VFX and material authoring helpers; generated assets are versioned separately.
/Source/ArenaEditor/**/*VfxEditorLibrary.h
/Source/ArenaEditor/**/*VfxEditorLibrary.cpp
/Source/ArenaEditor/**/*VFXEditorLibrary.h
/Source/ArenaEditor/**/*VFXEditorLibrary.cpp
/Source/ArenaEditor/**/*MaterialEditorLibrary.h
/Source/ArenaEditor/**/*MaterialEditorLibrary.cpp
